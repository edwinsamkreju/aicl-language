{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwinsamkreju/aicl-language/blob/main/benchmarks/live_agent/trace.schema.json",
  "title": "AICL live-agent benchmark trace",
  "description": "One complete task-language-trial run. Token counts must come from provider usage receipts, not estimates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "task_id", "trial_id", "language", "pair_order", "model_id", "model_snapshot", "tokenizer_id", "success", "tests_passed", "test_count", "retry_count", "wall_time_ms", "requests"],
  "properties": {
    "schema_version": { "const": "aicl-agent-trace/1.0" },
    "benchmark": { "const": "AICL-PY-100" },
    "task_id": { "type": "string", "minLength": 1 },
    "trial_id": { "type": "string", "minLength": 1 },
    "language": { "enum": ["python", "aicl"] },
    "pair_order": { "type": "integer", "enum": [1, 2] },
    "model_id": { "type": "string", "minLength": 1 },
    "model_snapshot": { "type": "string", "minLength": 1 },
    "tokenizer_id": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "tests_passed": { "type": "integer", "minimum": 0 },
    "test_count": { "type": "integer", "minimum": 1 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "wall_time_ms": { "type": "integer", "minimum": 0 },
    "requests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage", "input_tokens", "output_tokens", "tool_calls"],
        "properties": {
          "stage": { "enum": ["create", "inspect", "patch", "test", "repair", "other"] },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "tool_calls": { "type": "integer", "minimum": 0 },
          "latency_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
