{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicl.invalid/spec/aicl-python-bindings-0.2.schema.json",
  "title": "AICL Python binding manifest 0.2",
  "type": "object",
  "required": ["binding_hash", "schema", "module", "provider", "python", "exports"],
  "additionalProperties": false,
  "properties": {
    "binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schema": {"const": "aicl-python-bindings/0.2"},
    "module": {"type": "string", "minLength": 1},
    "provider": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "stdlib"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "distributions"], "properties": {"kind": {"const": "distribution"}, "distributions": {"type": "array", "items": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false},
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "unknown"}}, "additionalProperties": false}
      ]
    },
    "python": {
      "type": "object",
      "required": ["implementation", "version"],
      "additionalProperties": false,
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "effect", "capability", "type_source", "signature_verified", "parameters", "return_type"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "kind": {"const": "function"},
          "effect": {"const": "host"},
          "capability": {"type": "string", "minLength": 1},
          "type_source": {"enum": ["annotations", "explicit"]},
          "signature_verified": {"type": "boolean"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "kind", "required"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                "type": {"$ref": "#/$defs/type"},
                "kind": {"enum": ["positional_only", "positional_or_keyword", "keyword_only"]},
                "required": {"type": "boolean"}
              }
            }
          },
          "return_type": {"$ref": "#/$defs/type"}
        }
      }
    }
  },
  "$defs": {
    "type": {
      "oneOf": [
        {"enum": ["i64", "f64", "bool", "Str"]},
        {"type": "string", "pattern": "^List\\[(i64|f64|bool|Str|List\\[.*\\])\\]$"}
      ]
    }
  }
}
